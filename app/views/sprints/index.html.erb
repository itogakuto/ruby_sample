<h1><%= @project.name %>のSprint</h1>

<%= link_to "New Sprint", new_project_sprint_path(@project) %>

<ul>
    <% @sprints.each do |sprint| %>
        <li>
            <%= link_to sprint.customer_value_hypothesis.presence || "Sprint ##{sprint.id}",
                        project_sprint_path(@project, sprint) %>
        </li>
    <% end %>
</ul>

<%= link_to "Projectに戻る", project_path(@project) %>